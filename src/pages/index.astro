(function () {
  'use strict';

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Current year ───────────────────────────────────────── */
  var yearEl = document.getElementById('year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());

  /* ── Sticky header ──────────────────────────────────────── */
  var header = document.getElementById('header');
  var hero = document.querySelector('.hero');
  var heroInner = document.querySelector('.hero-inner');
  var scrollProgress = document.getElementById('scrollProgress');
  var parallaxLayers = document.querySelectorAll('.iso-bg');
  var scrollTicking = false;

  function updateScrollMotion() {
    var y = window.scrollY || 0;
    var maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
    var pageProgress = Math.min(Math.max(y / maxScroll, 0), 1);
    if (scrollProgress) scrollProgress.style.setProperty('--scroll-progress', pageProgress.toFixed(4));
    if (header) header.classList.toggle('stuck', y > 24);

    if (!reduce) {
      parallaxLayers.forEach(function (layer) {
        var rect = layer.parentElement.getBoundingClientRect();
        var offset = (window.innerHeight / 2 - (rect.top + rect.height / 2)) * .07;
        layer.style.setProperty('--parallax-y', offset.toFixed(1) + 'px');
      });
    }

    if (!reduce && hero && heroInner) {
      var distance = Math.max(hero.offsetHeight * .72, 1);
      var progress = Math.min(Math.max(y / distance, 0), 1);
      hero.style.setProperty('--hero-progress', progress.toFixed(3));
      heroInner.style.setProperty('--hero-shift', (progress * 52).toFixed(1) + 'px');
    }
    scrollTicking = false;
  }

  function onScroll() {
    if (scrollTicking) return;
    scrollTicking = true;
    window.requestAnimationFrame(updateScrollMotion);
  }
  updateScrollMotion();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* ── Mobile nav ─────────────────────────────────────────── */
  var toggle = document.getElementById('navToggle');
  var nav = document.getElementById('nav');
  function closeNav() {
    if (!nav || !toggle) return;
