:root[data-theme="claro"] .section-dark,
:root[data-theme="claro"] .section-cta{
  background:linear-gradient(168deg,var(--band-soft) 0%,var(--band) 100%);
  color:var(--ink);
  border-block:1px solid var(--band-line);
}
:root[data-theme="claro"] .section-cta{
  background:
    radial-gradient(900px 520px at 50% 0%, rgba(34,211,238,.14), transparent 64%),
    linear-gradient(168deg,var(--band-soft),var(--band));
}

:root[data-theme="claro"] .site-footer{
  background:var(--band);
  color:var(--ink-2);
  border-top:1px solid var(--band-line);
}

/* ─────────── Encabezados y acentos ─────────── */
:root[data-theme="claro"] .section-dark .kicker,
:root[data-theme="claro"] .section-cta .kicker{color:var(--cyan-ink)}
