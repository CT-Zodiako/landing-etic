/* ═══════════════════════════════════════════════════════════
   ETIC SAS — eticsas.co
   Design tokens → base → layout → components → responsive
   ═══════════════════════════════════════════════════════════ */

:root{
  /* Brand — sampled from the ETIC isometric logo */
  --navy-950:#04101F;
  --navy-900:#061529;
  --navy-800:#0A1F3C;
  --navy-700:#10305C;
  --navy-600:#1B4C86;

  --cyan-500:#06A6C4;
  --cyan-400:#22D3EE;
  --cyan-300:#67E8F9;
  --cyan-200:#A5F0FA;
  /* Foreground-on-light. --cyan-500 only reaches 2.68:1 on --mist, below the
     4.5:1 WCAG AA minimum for small text. This one measures 5.44:1. Use it for
     any text or icon on a light background; keep --cyan-500 for fills. */
  --cyan-ink:#0A6E85;

  --paper:#FFFFFF;
  --mist:#F2F7FC;
  --mist-2:#E6EFF7;
  --line:#D8E4F0;

  --ink:#0A1F3C;
  --ink-2:#3D5573;
  --ink-3:#6B819B;          /* placeholders on DARK — do not darken */
  --ink-muted:#566A80;      /* small labels on light: 5.17:1 on --mist */

  --on-dark:#EAF3FB;
  --on-dark-2:#9DB6D2;

  /* Type */
  --f-head:'Space Grotesk',system-ui,-apple-system,Segoe UI,sans-serif;
  --f-body:'Inter',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;

  /* Space */
  --wrap:1180px;
  --gut:clamp(20px,5vw,40px);
  --sec-y:clamp(72px,10vw,132px);

  --r-sm:10px;
  --r:16px;
  --r-lg:22px;

  --shadow-sm:0 1px 2px rgba(6,21,41,.06), 0 4px 14px rgba(6,21,41,.05);
  --shadow:0 2px 6px rgba(6,21,41,.07), 0 18px 44px rgba(6,21,41,.10);
  --shadow-cyan:0 10px 34px rgba(34,211,238,.28);

  --ease:cubic-bezier(.22,1,.36,1);

  /* Hero network colours, read by main.js so a theme can override them. */
  --net-link:34,211,238;
  --net-dot:103,232,249;
}

*,*::before,*::after{box-sizing:border-box}

html{
  scroll-behavior:smooth;
  -webkit-text-size-adjust:100%;
  scroll-padding-top:96px;
}

body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:var(--f-body);
  font-size:clamp(15.5px,1.05vw,17px);
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}

img,svg,canvas{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
ul{margin:0;padding:0;list-style:none}
h1,h2,h3,h4{font-family:var(--f-head);line-height:1.1;margin:0;letter-spacing:-.02em}
p{margin:0}

:focus-visible{
  outline:2.5px solid var(--cyan-400);
  outline-offset:3px;
  border-radius:4px;
}

.wrap{width:100%;max-width:var(--wrap);margin-inline:auto;padding-inline:var(--gut)}

.skip-link{
  position:absolute;left:-9999px;top:0;z-index:200;
  background:var(--navy-900);color:#fff;padding:12px 20px;border-radius:0 0 var(--r-sm) 0;
}
.skip-link:focus{left:0}

.grad{
  background:linear-gradient(100deg,var(--cyan-300) 0%,var(--cyan-400) 45%,var(--cyan-500) 100%);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
}

/* ═══════════════ REVEAL ═══════════════ */
.reveal{
  opacity:0;
  transform:translateY(22px);
  transition:opacity .8s var(--ease) var(--d,0s), transform .8s var(--ease) var(--d,0s);
  will-change:opacity,transform;
}
.reveal.in{opacity:1;transform:none}

/* ═══════════════ BUTTONS ═══════════════ */
.btn{
  --btn-bg:transparent;
  display:inline-flex;align-items:center;gap:.55em;
  font-family:var(--f-head);font-weight:600;font-size:.95rem;
  padding:.82em 1.5em;border:1.5px solid transparent;border-radius:999px;
  cursor:pointer;position:relative;isolation:isolate;
  transition:transform .35s var(--ease), box-shadow .35s var(--ease),
             background-color .3s, color .3s, border-color .3s;
}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0)}
.btn .ico{width:1em;height:1em;flex:none;transition:transform .35s var(--ease)}
.btn:hover .ico{transform:translateX(4px)}

.btn-primary{
  background:linear-gradient(100deg,var(--cyan-400),var(--cyan-500));
  color:var(--navy-950);
  box-shadow:0 6px 20px rgba(34,211,238,.30);
}
.btn-primary:hover{box-shadow:var(--shadow-cyan)}

.btn-ghost{
  border-color:rgba(157,182,210,.42);
  color:var(--on-dark);
  backdrop-filter:blur(6px);
  background:rgba(255,255,255,.04);
}
.btn-ghost:hover{border-color:var(--cyan-400);color:var(--cyan-300)}

.btn-lg{font-size:1rem;padding:.95em 1.8em}
.btn-sm{font-size:.87rem;padding:.62em 1.2em}

/* ═══════════════ HEADER ═══════════════ */
.scroll-progress{
  position:fixed;top:0;left:0;z-index:120;
  width:100%;height:3px;
  transform:scaleX(var(--scroll-progress,0));
  transform-origin:left center;
  background:linear-gradient(90deg,var(--cyan-400),#8af3ff);
  box-shadow:0 0 14px rgba(34,211,238,.65);
  pointer-events:none;
}
.site-header{
  position:fixed;inset:0 0 auto 0;z-index:100;
  transition:background-color .45s var(--ease), box-shadow .45s var(--ease),
             backdrop-filter .45s, border-color .45s;
  border-bottom:1px solid transparent;
}
.site-header.stuck{
  background:rgba(6,21,41,.82);
  backdrop-filter:blur(16px) saturate(150%);
  border-bottom-color:rgba(157,182,210,.14);
  box-shadow:0 10px 34px rgba(4,16,31,.30);
}

.header-inner{
  display:flex;align-items:center;justify-content:space-between;gap:24px;
  min-height:84px;
}

.brand{display:flex;align-items:center;gap:13px;flex:none;min-width:0}

/* The wordmark is 504×278 (≈1.81:1). Height-driven so the aspect never
   distorts, with the intrinsic width/height attributes reserving space. */
/* 46px, not 38: the wordmark carries circuit traces and code text inside
   the letters, and below ~44px it stops reading as "ETIC" at all. */
.brand-logo{
  height:46px;width:auto;flex:none;
  filter:drop-shadow(0 3px 12px rgba(34,211,238,.30));
  transition:transform .5s var(--ease), filter .5s var(--ease);
}
.brand:hover .brand-logo{
  transform:scale(1.05);
  filter:drop-shadow(0 4px 16px rgba(34,211,238,.55));
}

.brand-text{
  display:flex;flex-direction:column;
  padding-left:13px;
  border-left:1px solid rgba(157,182,210,.24);
}
.brand-text em{
  font-family:var(--f-head);font-style:normal;font-weight:600;
  font-size:.79rem;line-height:1.4;
  letter-spacing:.11em;text-transform:uppercase;
  color:var(--cyan-300);opacity:.92;
}

.nav{display:flex;align-items:center;gap:6px}
.nav > a:not(.btn){
  font-size:.92rem;font-weight:500;color:var(--on-dark);
  padding:.55em .9em;border-radius:999px;
  transition:color .28s, background-color .28s;
}
.nav > a:not(.btn):hover{color:var(--cyan-300);background:rgba(34,211,238,.10)}
.nav .btn{margin-left:10px}

.nav-toggle{
  display:none;flex-direction:column;gap:5px;
  width:44px;height:44px;align-items:center;justify-content:center;
  background:rgba(255,255,255,.06);border:1px solid rgba(157,182,210,.24);
  border-radius:12px;cursor:pointer;
}
.nav-toggle span{
  display:block;width:19px;height:2px;background:var(--on-dark);border-radius:2px;
  transition:transform .35s var(--ease), opacity .25s;
}
.nav-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}
.nav-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* ═══════════════ HERO ═══════════════ */
.hero{
  position:relative;
  min-height:min(100svh,900px);
  display:flex;align-items:center;
  padding:150px 0 clamp(80px,12vw,130px);
  background:
    radial-gradient(1100px 620px at 78% -8%, rgba(27,76,134,.55), transparent 62%),
    radial-gradient(760px 520px at 8% 108%, rgba(6,166,196,.20), transparent 66%),
    linear-gradient(168deg,var(--navy-900) 0%,var(--navy-950) 100%);
  color:var(--on-dark);
  overflow:hidden;
  isolation:isolate;
}
.hero-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:-2;opacity:.62}
.hero-glow{
  position:absolute;z-index:-1;
  width:min(72vw,780px);aspect-ratio:1;
  right:-14%;top:-22%;
  background:radial-gradient(circle,rgba(34,211,238,.20),transparent 64%);
  filter:blur(30px);
  animation:float 16s var(--ease) infinite alternate;
}
@keyframes float{
  from{transform:translate3d(0,0,0) scale(1)}
  to{transform:translate3d(-5%,7%,0) scale(1.12)}
}

.hero-inner{
  position:relative;max-width:900px;
  transform:translate3d(0,var(--hero-shift,0px),0);
  will-change:transform;
}
.hero-title.in{
  transform:translate3d(0,calc(var(--hero-progress,0) * -34px),0);
  opacity:calc(1 - var(--hero-progress,0) * .58);
}
.hero-sub.in,.hero-cta.in,.stats.in{
  transform:translate3d(0,calc(var(--hero-progress,0) * -18px),0);
  opacity:calc(1 - var(--hero-progress,0) * .42);
}
.hero-glow{will-change:transform}

.eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--f-head);font-size:.82rem;font-weight:600;
  letter-spacing:.17em;text-transform:uppercase;
  color:var(--cyan-300);
  border:1px solid rgba(34,211,238,.30);
  background:rgba(34,211,238,.08);
  padding:.55em 1.15em;border-radius:999px;
  margin-bottom:26px;
}
.pulse-dot{
  width:7px;height:7px;border-radius:50%;background:var(--cyan-400);flex:none;
  box-shadow:0 0 0 0 rgba(34,211,238,.7);
  animation:pulse 2.4s ease-out infinite;
}
@keyframes pulse{
  70%{box-shadow:0 0 0 11px rgba(34,211,238,0)}
  100%{box-shadow:0 0 0 0 rgba(34,211,238,0)}
}

.hero-title{
  font-size:clamp(2.5rem,7.2vw,5.1rem);
  font-weight:700;
  letter-spacing:-.035em;
  margin-bottom:26px;
  color:#fff;
}

.hero-sub{
  font-size:clamp(1.02rem,1.5vw,1.24rem);
  color:var(--on-dark-2);
  max-width:660px;
  margin-bottom:38px;
}
.hero-sub strong{color:var(--on-dark);font-weight:600}

.hero-cta{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:clamp(48px,7vw,72px)}

.stats{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(148px,1fr));
  gap:clamp(18px,3vw,34px);
  padding-top:34px;
  border-top:1px solid rgba(157,182,210,.18);
}
.stats li{display:flex;flex-direction:column;gap:5px}
.stat-n{
  font-family:var(--f-head);font-weight:700;
  font-size:clamp(1.9rem,3.4vw,2.7rem);
  line-height:1;
  background:linear-gradient(140deg,#fff 10%,var(--cyan-300) 100%);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  font-variant-numeric:tabular-nums;
}
.stat-l{font-size:.82rem;color:var(--on-dark-2);line-height:1.4}

.scroll-hint{
  position:absolute;left:50%;bottom:26px;transform:translateX(-50%);
  width:24px;height:38px;border:1.5px solid rgba(157,182,210,.32);border-radius:14px;
}
.scroll-hint span{
  position:absolute;left:50%;top:8px;translate:-50% 0;
  width:3px;height:7px;border-radius:2px;background:var(--cyan-400);
  animation:wheel 1.9s var(--ease) infinite;
}
@keyframes wheel{
  0%{opacity:0;transform:translateY(0)}
  35%{opacity:1}
  100%{opacity:0;transform:translateY(14px)}
}

/* ═══════════════ STRIP ═══════════════ */
.strip{
  background:var(--navy-950);
  color:var(--on-dark);
  padding:clamp(52px,7vw,86px) 0;
  border-top:1px solid rgba(157,182,210,.10);
}
.strip-inner{max-width:940px;margin-inline:auto;text-align:center}
.strip-quote{
  font-family:var(--f-head);font-weight:500;
  font-size:clamp(1.28rem,2.9vw,2.1rem);
  line-height:1.32;letter-spacing:-.025em;
  color:var(--on-dark-2);
}
.strip-quote .grad{display:block;margin-top:.35em;font-weight:700}

/* The compliance half of the thesis: same sentence, quieter voice, so the
   promise reads as a condition rather than a second headline. */
.strip-tail{
  display:block;
  margin-top:.6em;
  font-family:var(--f-body);font-weight:400;
  font-size:clamp(.95rem,1.35vw,1.1rem);
  line-height:1.6;
  color:var(--on-dark-2);
  max-width:660px;margin-inline:auto;
}

/* ═══════════════ SECTIONS ═══════════════ */
.section{padding:var(--sec-y) 0;position:relative;isolation:isolate}
.section-mist{background:var(--mist);border-block:1px solid var(--line)}

.section-dark,.section-cta{
  background:linear-gradient(168deg,var(--navy-800) 0%,var(--navy-950) 100%);
  color:var(--on-dark);
  overflow:hidden;
}
.section-cta{
  background:
    radial-gradient(900px 520px at 50% 0%, rgba(27,76,134,.52), transparent 64%),
    linear-gradient(168deg,var(--navy-900),var(--navy-950));
}

/* Isometric grid backdrop for dark sections */
.iso-bg{
  position:absolute;inset:0;z-index:-1;pointer-events:none;
  opacity:.4;
  transform:translate3d(0,var(--parallax-y,0px),0);
  will-change:transform;
  background-image:
    linear-gradient(30deg,rgba(157,182,210,.075) 1px,transparent 1px),
    linear-gradient(-30deg,rgba(157,182,210,.075) 1px,transparent 1px);
  background-size:56px 32px;
  mask-image:radial-gradient(110% 78% at 50% 34%,#000 20%,transparent 78%);
  -webkit-mask-image:radial-gradient(110% 78% at 50% 34%,#000 20%,transparent 78%);
}

.sec-head{max-width:720px;margin-bottom:clamp(44px,6vw,68px)}
.sec-head-tight{margin-bottom:clamp(32px,4vw,46px)}
.sec-head-center{max-width:660px;margin-inline:auto;text-align:center}

.kicker{
  font-family:var(--f-head);font-size:.82rem;font-weight:600;
  letter-spacing:.19em;text-transform:uppercase;
  color:var(--cyan-ink);
  margin-bottom:14px;
}
.section-dark .kicker,.section-cta .kicker{color:var(--cyan-300)}

.sec-head h2{
  font-size:clamp(1.85rem,4.1vw,3.05rem);
  font-weight:700;letter-spacing:-.032em;
  margin-bottom:18px;
}
.section-dark .sec-head h2,.section-cta .sec-head h2{color:#fff}

.lede{font-size:clamp(1rem,1.3vw,1.12rem);color:var(--ink-2)}
.section-dark .lede,.section-cta .lede{color:var(--on-dark-2)}

.grid{display:grid;gap:clamp(16px,2vw,24px)}
.cards{grid-template-columns:repeat(auto-fit,minmax(292px,1fr))}
.cap-grid{grid-template-columns:repeat(auto-fit,minmax(272px,1fr))}
/* min() keeps the track from exceeding a narrow container and eating the
   page gutter — plain minmax(340px,1fr) overflows below ~375px. */
.cases{grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr))}

/* Even rows on wide screens, so a fixed-count set never orphans one card. */
@media (min-width:1000px){
  .cards-3{grid-template-columns:repeat(3,1fr)}
  .cards-4{grid-template-columns:repeat(2,1fr)}
}
/* Deliberately NOT four across: at 1440px a four-column row leaves a
   27-character measure, far under the 45-character readability floor. */

/* ═══════════════ SOLUTION CARDS ═══════════════ */
.card{
  --mx:50%;--my:0%;
  position:relative;isolation:isolate;overflow:hidden;
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:var(--r-lg);
  padding:clamp(26px,3vw,34px);
  box-shadow:var(--shadow-sm);
  transition:transform .5s var(--ease), box-shadow .5s var(--ease), border-color .4s;
}
.card::before{
  content:'';position:absolute;inset:0;z-index:-1;
  background:radial-gradient(360px circle at var(--mx) var(--my),rgba(34,211,238,.13),transparent 68%);
  opacity:0;transition:opacity .45s;
}
.card::after{
  content:'';position:absolute;inset:auto 0 0 0;height:3px;
  background:linear-gradient(90deg,var(--cyan-400),var(--cyan-500));
  transform:scaleX(0);transform-origin:left;
  transition:transform .55s var(--ease);
}
.card:hover{
  transform:translateY(-7px);
  box-shadow:var(--shadow);
  border-color:rgba(34,211,238,.42);
}
.card:hover::before{opacity:1}
.card:hover::after{transform:scaleX(1)}

.card-num{
  display:block;
  font-family:var(--f-head);font-weight:700;font-size:.86rem;
  letter-spacing:.14em;color:var(--cyan-ink);
  margin-bottom:14px;
}

.card-ico{
  display:grid;place-items:center;
  width:50px;height:50px;margin-bottom:20px;
  border-radius:14px;
  color:var(--cyan-ink);
  background:linear-gradient(150deg,rgba(34,211,238,.16),rgba(6,166,196,.08));
  border:1px solid rgba(34,211,238,.30);
}
.card-ico svg{width:24px;height:24px}
.card h3{font-size:1.24rem;font-weight:600;margin-bottom:11px}
.card p{color:var(--ink-2);font-size:.955rem;margin-bottom:18px}

/* Second paragraph on the denser module cards: the consequence, set apart
   from the mechanism above it. */
.card .card-more{
  margin-top:-6px;
  padding-top:14px;
  border-top:1px dashed var(--line);
  font-size:.91rem;
}
.card .card-more strong{color:var(--ink);font-weight:600}

/* Full-row card: closes a 7-item grid that would otherwise leave one card
   alone in the last row. Two internal columns so it does not read as sparse. */
.card-wide{grid-column:1 / -1}
.card-wide p{margin-bottom:0}
.cw-head{margin-bottom:16px}
.cw-head .card-num{margin-bottom:10px}
.cw-head h3{margin-bottom:12px}

@media (min-width:860px){
  .card-wide{
    display:grid;
    grid-template-columns:minmax(220px,.85fr) 1.15fr;
    gap:clamp(24px,3vw,44px);
    align-items:start;
  }
  .cw-head{margin-bottom:0}
  .cw-head h3{margin-bottom:14px}
}

.tags{display:flex;flex-wrap:wrap;gap:7px}
.tags li{
  font-size:.8rem;font-weight:600;letter-spacing:.05em;
  padding:.36em .8em;border-radius:999px;border:1px solid;
}
.t-cmp{color:#0E4F6E;background:#E4F6FC;border-color:#B9E6F5}
/* The CRA chip is the through-line across every tariff module, so it reads
   stronger than the functional chips beside it. */
.t-cra{color:#fff;background:linear-gradient(100deg,#10305C,#1B4C86);border-color:#1B4C86}
.t-est{color:#2F3E86;background:#EAEEFC;border-color:#C6D0F5}
.t-efi{color:#0F5B47;background:#E3F7F0;border-color:#B6E8D8}

.note{
  margin-top:clamp(28px,3.5vw,40px);
  text-align:center;font-size:.98rem;color:var(--ink-2);
}
.note strong{color:var(--ink)}

/* Statement that ties the six tariff modules to one regulatory root. */
.root-note{
  position:relative;
  /* Capped near 68 characters; unconstrained it ran to 150 per line. */
  max-width:62ch;
  margin-bottom:clamp(34px,4.5vw,50px);
  padding:22px 26px 22px 30px;
  border-radius:var(--r);
  background:var(--paper);
  border:1px solid var(--line);
  border-left:3px solid var(--cyan-400);
  font-size:1rem;color:var(--ink-2);
  box-shadow:var(--shadow-sm);
}
.root-note strong{color:var(--ink)}

/* ═══════════════ BLOQUE "EN CURSO" ═══════════════ */
.ahead{
  margin-top:clamp(34px,4.5vw,52px);
  padding:clamp(28px,3.6vw,42px);
  border-radius:var(--r-lg);
  background:
    radial-gradient(700px 320px at 88% -30%, rgba(34,211,238,.16), transparent 62%),
    linear-gradient(150deg,var(--navy-800),var(--navy-950));
  color:var(--on-dark);
  border:1px solid rgba(34,211,238,.26);
  box-shadow:var(--shadow);
}
.ahead-tag{
  display:inline-flex;align-items:center;gap:9px;
  font-family:var(--f-head);font-size:.8rem;font-weight:600;
  letter-spacing:.16em;text-transform:uppercase;
  color:var(--cyan-300);
  padding:.44em 1em;margin-bottom:18px;
  border-radius:999px;
  background:rgba(34,211,238,.10);
  border:1px solid rgba(34,211,238,.30);
}
.ahead h3{
  font-size:clamp(1.35rem,3vw,2.15rem);
  font-weight:700;letter-spacing:-.03em;
  color:#fff;margin-bottom:16px;max-width:820px;
}
.ahead p{
  font-size:clamp(1rem,1.3vw,1.1rem);
  color:var(--on-dark-2);max-width:760px;
}
.ahead p strong{color:#fff;font-weight:600}
.ahead .btn{margin-top:26px}
/* Matches the marquee's top margin below it, so the block sits with equal
   air on both sides. The small original value assumed this block followed
   another .ahead; in #stack it follows the cloud list instead. */
.ahead-ai{margin-top:clamp(44px,6vw,76px)}

/* The "within the statutory deadline" pledge: the most concrete promise on
   the page, so it gets its own framed block rather than a line of body copy. */
.ahead .ahead-pledge{
  margin-top:24px;
  padding:20px 24px;
  border-radius:var(--r-sm);
  background:rgba(34,211,238,.08);
  border:1px solid rgba(34,211,238,.28);
  border-left:3px solid var(--cyan-400);
  font-size:1rem;color:var(--on-dark);
  max-width:760px;
}
.ahead-pledge-k{
  display:block;
  font-family:var(--f-head);font-size:.8rem;font-weight:600;
  letter-spacing:.18em;text-transform:uppercase;
  color:var(--cyan-300);
  margin-bottom:8px;
}
.ahead .ahead-pledge strong{color:var(--cyan-200)}

/* ═══════════════ CAPABILITIES ═══════════════ */
.cap{
  background:rgba(255,255,255,.035);
  border:1px solid rgba(157,182,210,.16);
  border-radius:var(--r-lg);
  padding:clamp(26px,3vw,34px);
  backdrop-filter:blur(8px);
  transition:transform .5s var(--ease), border-color .4s, background-color .4s;
}
.cap:hover{
  transform:translateY(-6px);
  border-color:rgba(34,211,238,.44);
  background:rgba(34,211,238,.07);
}
.cap-ico{
  display:grid;place-items:center;
  width:50px;height:50px;margin-bottom:20px;
  border-radius:14px;
  color:var(--cyan-300);
  background:rgba(34,211,238,.12);
  border:1px solid rgba(34,211,238,.26);
}
.cap-ico svg{width:24px;height:24px}
.cap h3{font-size:1.2rem;font-weight:600;color:#fff;margin-bottom:11px}
.cap p{color:var(--on-dark-2);font-size:.955rem}

/* ═══════════════ CASOS ═══════════════ */
.case{
  position:relative;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(157,182,210,.16);
  border-radius:var(--r-lg);
  padding:clamp(28px,3.4vw,40px);
  backdrop-filter:blur(8px);
  transition:transform .5s var(--ease), border-color .4s, background-color .4s;
}
.case:hover{
  transform:translateY(-6px);
  border-color:rgba(34,211,238,.44);
  background:rgba(34,211,238,.06);
}
.case-tag{
  display:inline-block;
  font-family:var(--f-head);font-size:.79rem;font-weight:600;
  letter-spacing:.15em;text-transform:uppercase;
  color:var(--cyan-300);
  padding:.4em .9em;margin-bottom:16px;
  border-radius:999px;
  background:rgba(34,211,238,.12);
  border:1px solid rgba(34,211,238,.26);
}
.case h3{
  font-size:clamp(1.24rem,2.1vw,1.55rem);
  font-weight:600;color:#fff;margin-bottom:14px;
}
.case p{color:var(--on-dark-2);font-size:.965rem}
.case p + p{margin-top:12px}

.case-stack{
  display:flex;flex-wrap:wrap;gap:7px;
  margin-top:22px;padding-top:20px;
  border-top:1px solid rgba(157,182,210,.16);
}
.case-stack li{
  font-family:var(--f-head);font-size:.82rem;font-weight:600;
  color:var(--on-dark);
  padding:.38em .85em;border-radius:8px;
  background:rgba(4,16,31,.45);
  border:1px solid rgba(157,182,210,.20);
}

/* ═══════════════ SECTORES ═══════════════ */
.sectors{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(min(150px,100%),1fr));
  gap:12px;
  margin-bottom:clamp(30px,4vw,44px);
}
/* Six sectors: auto-fit lands on 4+2 at tablet width, which orphans a row.
   Force 3+3 in that band and let wide screens take all six across. */
@media (min-width:520px) and (max-width:1039px){
  .sectors{grid-template-columns:repeat(3,1fr)}
}
@media (min-width:1040px){
  .sectors{grid-template-columns:repeat(6,1fr)}
}

.sectors li{
  display:flex;flex-direction:column;align-items:center;gap:10px;
  text-align:center;
  padding:22px 14px;
  border-radius:var(--r);
  background:var(--paper);
  border:1px solid var(--line);
  box-shadow:var(--shadow-sm);
  font-family:var(--f-head);font-weight:600;font-size:.94rem;
  color:var(--ink);
  transition:transform .45s var(--ease), border-color .4s, box-shadow .45s var(--ease);
}
.sectors li:hover{
  transform:translateY(-5px);
  border-color:rgba(34,211,238,.48);
  box-shadow:var(--shadow);
}
.sec-ico{
  display:grid;place-items:center;
  width:42px;height:42px;border-radius:12px;
  color:var(--cyan-ink);
  background:linear-gradient(150deg,rgba(34,211,238,.16),rgba(6,166,196,.07));
  border:1px solid rgba(34,211,238,.28);
}
.sec-ico svg{width:21px;height:21px}

/* ═══════════════ MARCO REGULATORIO ═══════════════ */
.regs{
  padding:clamp(26px,3.4vw,38px);
  border-radius:var(--r-lg);
  background:linear-gradient(150deg,var(--navy-800),var(--navy-950));
  color:var(--on-dark);
  margin-bottom:clamp(30px,4vw,44px);
  box-shadow:var(--shadow);
}
.regs-lead{
  font-size:1.02rem;color:var(--on-dark-2);
  max-width:720px;margin-bottom:24px;
}
.regs-lead strong{color:#fff;font-weight:600}

.regs-list{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(min(210px,100%),1fr));
  gap:14px;
}
.regs-list li{
  display:flex;flex-direction:column;gap:5px;
  padding:18px 20px;
  border-radius:var(--r-sm);
  background:rgba(255,255,255,.05);
  border:1px solid rgba(157,182,210,.18);
  transition:border-color .4s, background-color .4s;
}
.regs-list li:hover{border-color:rgba(34,211,238,.45);background:rgba(34,211,238,.08)}
.regs-list strong{
  font-family:var(--f-head);font-weight:700;font-size:1.14rem;
  letter-spacing:.03em;color:var(--cyan-300);
}
.regs-list span{font-size:.79rem;color:var(--on-dark-2);line-height:1.4}

.regs-note{margin-top:18px;font-size:.88rem;color:var(--on-dark-2);opacity:.8}

/* ═══════════════ MOTORES DE DATOS ═══════════════ */
.group-label{
  font-family:var(--f-head);font-size:.82rem;font-weight:600;
  letter-spacing:.18em;text-transform:uppercase;
  color:var(--ink-muted);
  margin-bottom:14px;
}
.engines{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(min(190px,100%),1fr));
  gap:14px;
  margin-bottom:clamp(32px,4vw,44px);
}
.engines-cloud{margin-bottom:clamp(38px,5vw,54px)}
.engines li{
  display:flex;flex-direction:column;gap:5px;
  padding:24px 22px;
  border-radius:var(--r);
  background:var(--paper);
  border:1px solid var(--line);
  box-shadow:var(--shadow-sm);
  transition:transform .45s var(--ease), border-color .4s, box-shadow .45s var(--ease);
}
.engines li:hover{
  transform:translateY(-5px);
  border-color:rgba(34,211,238,.45);
  box-shadow:var(--shadow);
}
.engines strong{
  font-family:var(--f-head);font-weight:700;font-size:1.1rem;
  letter-spacing:-.01em;color:var(--ink);
}
.engines span{font-size:.83rem;color:var(--ink-2);line-height:1.45}

/* ═══════════════ NOSOTROS ═══════════════ */
.nos-layout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:clamp(36px,5vw,72px);
  align-items:start;
}
.nos-copy h2{
  font-size:clamp(1.8rem,3.7vw,2.75rem);
  font-weight:700;letter-spacing:-.032em;margin-bottom:18px;
}
.nos-copy .lede{margin-bottom:30px}

.pillars{display:flex;flex-direction:column;gap:14px}
.pillars li{
  position:relative;
  padding:24px 26px 24px 28px;
  border-radius:var(--r);
  background:var(--mist);
  border:1px solid var(--line);
  transition:transform .45s var(--ease), background-color .4s, border-color .4s;
}
.pillars li::before{
  content:'';position:absolute;left:0;top:18px;bottom:18px;width:3px;
  border-radius:0 3px 3px 0;
  background:linear-gradient(var(--cyan-400),var(--cyan-500));
  transition:top .45s var(--ease), bottom .45s var(--ease);
}
.pillars li:hover{
  transform:translateX(6px);
  background:var(--paper);
  border-color:rgba(34,211,238,.40);
  box-shadow:var(--shadow-sm);
}
.pillars li:hover::before{top:8px;bottom:8px}
.pillars h4{
  display:flex;align-items:center;gap:10px;
  font-size:1.06rem;font-weight:600;margin-bottom:8px;
}
.pillars h4 span{color:var(--cyan-ink);font-size:1.1em}
.pillars p{color:var(--ink-2);font-size:.93rem}

/* ═══════════════ EQUIPO ═══════════════ */
.team{
  margin-top:clamp(44px,6vw,72px);
  padding-top:clamp(36px,4.5vw,54px);
  border-top:1px solid var(--line);
}
.team h3{
  font-size:clamp(1.5rem,3vw,2.1rem);
  font-weight:700;letter-spacing:-.03em;
  margin-bottom:14px;
}
.team-lede{
  font-size:clamp(1rem,1.3vw,1.1rem);
  color:var(--ink-2);max-width:700px;
  margin-bottom:clamp(28px,3.5vw,40px);
}
.team-lede strong{color:var(--ink);font-weight:600}

.team-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(min(230px,100%),1fr));
  gap:14px;
  margin-bottom:clamp(26px,3.4vw,38px);
}
.team-grid li{
  display:flex;flex-direction:column;gap:6px;
  padding:24px 22px;
  border-radius:var(--r);
  background:var(--paper);
  border:1px solid var(--line);
  box-shadow:var(--shadow-sm);
  transition:transform .45s var(--ease), border-color .4s, box-shadow .45s var(--ease);
}
.team-grid li:hover{
  transform:translateY(-5px);
  border-color:rgba(34,211,238,.46);
  box-shadow:var(--shadow);
}
.tg-ico{
  display:grid;place-items:center;
  width:42px;height:42px;margin-bottom:8px;
  border-radius:12px;color:var(--cyan-ink);
  background:linear-gradient(150deg,rgba(34,211,238,.16),rgba(6,166,196,.07));
  border:1px solid rgba(34,211,238,.28);
}
.tg-ico svg{width:21px;height:21px}
.team-grid strong{
  font-family:var(--f-head);font-weight:600;font-size:1.03rem;color:var(--ink);
}
.team-grid li > span:not(.tg-ico){font-size:.85rem;color:var(--ink-2);line-height:1.45}

/* Standards: expertise in ISO / CMMI, deliberately not worded as
   certification. Kept visually quieter than a badge for that reason. */
/* #nosotros is a mist section, so this panel goes white and its chips go
   mist — otherwise the block is invisible against its own background. */
.std{
  padding:24px 26px;
  border-radius:var(--r);
  background:var(--paper);
  border:1px solid var(--line);
  box-shadow:var(--shadow-sm);
}
.std-k{
  font-family:var(--f-head);font-size:.82rem;font-weight:600;
  letter-spacing:.18em;text-transform:uppercase;
  color:var(--ink-muted);margin-bottom:14px;
}
.std-list{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:14px}
.std-list li{
  display:flex;flex-direction:column;gap:2px;
  padding:12px 20px;
  border-radius:var(--r-sm);
  background:var(--mist);
  border:1px solid var(--line);
}
.std-list strong{
  font-family:var(--f-head);font-weight:700;font-size:1.06rem;
  letter-spacing:.05em;color:var(--navy-700);
}
.std-list span{font-size:.79rem;color:var(--ink-2)}
.std-note{font-size:.85rem;color:var(--ink-2)}

/* ═══════════════ MARQUEE ═══════════════ */
.marquee{
  position:relative;overflow:hidden;
  /* The marquee sits outside .wrap, so it inherited no vertical rhythm and
     ended up flush against the block above it. Matches the 76px of air that
     precedes that block, so the band reads as separated on both sides. */
  margin-top:clamp(44px,6vw,76px);
  padding:6px 0;
  mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);
}
.marquee-track{display:flex;width:max-content;animation:slide 34s linear infinite}
.marquee:hover .marquee-track{animation-play-state:paused}
@keyframes slide{to{transform:translateX(-50%)}}

.marquee-set{display:flex;gap:12px;padding-right:12px}
.marquee-set li{
  flex:none;
  font-family:var(--f-head);font-weight:600;font-size:.95rem;
  color:var(--ink-2);
  padding:.68em 1.4em;
  border-radius:999px;
  background:var(--paper);
  border:1px solid var(--line);
  box-shadow:var(--shadow-sm);
  transition:color .3s, border-color .3s, transform .3s var(--ease);
}
.marquee-set li:hover{color:var(--cyan-ink);border-color:rgba(34,211,238,.5);transform:translateY(-3px)}

/* ═══════════════ CONTACTO ═══════════════ */
.cta-inner{position:relative}
.contact-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(212px,1fr));
  gap:14px;
  margin-bottom:clamp(38px,5vw,56px);
}
.contact-card{
  display:flex;flex-direction:column;gap:5px;
  padding:26px 24px;
  border-radius:var(--r);
  background:rgba(255,255,255,.045);
  border:1px solid rgba(157,182,210,.18);
  backdrop-filter:blur(8px);
  transition:transform .45s var(--ease), border-color .4s, background-color .4s;
}
.contact-card:hover{
  transform:translateY(-5px);
  border-color:rgba(34,211,238,.48);
  background:rgba(34,211,238,.09);
}
.cc-ico{
  display:grid;place-items:center;
  width:40px;height:40px;margin-bottom:12px;
  border-radius:11px;color:var(--cyan-300);
  background:rgba(34,211,238,.13);
  border:1px solid rgba(34,211,238,.26);
}
.cc-ico svg{width:20px;height:20px}
.cc-l{
  font-size:.79rem;font-weight:600;letter-spacing:.15em;text-transform:uppercase;
  color:var(--on-dark-2);
}
.cc-v{font-family:var(--f-head);font-weight:600;font-size:1.01rem;color:#fff;word-break:break-word}

.contact-form{
  max-width:660px;margin-inline:auto;
  padding:clamp(26px,3.5vw,40px);
  border-radius:var(--r-lg);
  background:rgba(255,255,255,.045);
  border:1px solid rgba(157,182,210,.18);
  backdrop-filter:blur(10px);
}
.cf-intro{color:var(--on-dark-2);font-size:.95rem;margin-bottom:20px;text-align:center}
.cf-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}

.field{display:block;margin-bottom:14px}
.field > span{
  display:block;
  font-size:.8rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;
  color:var(--on-dark-2);margin-bottom:7px;
}
.field input,.field textarea{
  width:100%;
  font-family:var(--f-body);font-size:.97rem;color:#fff;
  padding:.8em 1em;
  background:rgba(4,16,31,.5);
  border:1px solid rgba(157,182,210,.24);
  border-radius:var(--r-sm);
  transition:border-color .3s, background-color .3s, box-shadow .3s;
  resize:vertical;
}
.field input::placeholder,.field textarea::placeholder{color:var(--ink-3)}
.field input:focus,.field textarea:focus{
  outline:none;
  border-color:var(--cyan-400);
  background:rgba(4,16,31,.72);
  box-shadow:0 0 0 3px rgba(34,211,238,.16);
}
.field input:user-invalid,.field textarea:user-invalid{border-color:#F98080}

.contact-form .btn{width:100%;justify-content:center;margin-top:8px}
.cf-hint{
  min-height:1.3em;margin-top:12px;text-align:center;
  font-size:.87rem;color:var(--cyan-300);
}

/* ═══════════════ FOOTER ═══════════════ */
.site-footer{
  background:var(--navy-950);
  color:var(--on-dark-2);
  padding:clamp(40px,5vw,60px) 0;
  border-top:1px solid rgba(157,182,210,.12);
}
.footer-inner{
  display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;
  gap:26px;
}
.footer-brand{display:flex;flex-direction:column;gap:8px;align-items:flex-start}
.footer-logo{height:46px;width:auto}
.footer-brand span{font-size:.8rem;letter-spacing:.06em;color:var(--cyan-300)}
.footer-brand em{font-style:italic;font-size:.82rem;opacity:.75}

.footer-nav{display:flex;flex-wrap:wrap;gap:20px}
.footer-nav a{font-size:.9rem;transition:color .28s}
.footer-nav a:hover{color:var(--cyan-300)}

.footer-legal{width:100%;font-size:.8rem;opacity:.6;padding-top:22px;border-top:1px solid rgba(157,182,210,.1)}

/* ═══════════════ RESPONSIVE ═══════════════ */
@media (max-width:900px){
  .nos-layout{grid-template-columns:1fr}
}

@media (max-width:820px){
  .nav-toggle{display:flex}
  .nav{
    position:fixed;inset:84px 0 auto 0;
    flex-direction:column;align-items:stretch;gap:2px;
    padding:18px var(--gut) 26px;
    background:rgba(6,21,41,.97);
    backdrop-filter:blur(18px);
    border-bottom:1px solid rgba(157,182,210,.16);
    box-shadow:0 18px 44px rgba(4,16,31,.45);
    transform:translateY(-118%);
    opacity:0;visibility:hidden;
    transition:transform .45s var(--ease), opacity .35s, visibility .35s;
  }
  .nav.open{transform:none;opacity:1;visibility:visible}
  .nav > a:not(.btn){padding:.9em 1em;font-size:1.02rem;border-radius:var(--r-sm)}
  .nav .btn{margin:12px 0 0;justify-content:center}
  .hero{padding-top:128px}
  .scroll-hint{display:none}
}

@media (max-width:640px){
  /* The two-line tagline crowds the header once the hamburger appears. */
  .brand-text{display:none}
}

@media (max-width:560px){
  .stats{grid-template-columns:1fr 1fr;gap:22px}
  .cf-row{grid-template-columns:1fr}
  .hero-cta .btn{width:100%;justify-content:center}
  .footer-inner{flex-direction:column;align-items:flex-start}
}

/* ═══════════════ MOTION / PRINT ═══════════════ */
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{
    animation-duration:.001ms !important;
    animation-iteration-count:1 !important;
    transition-duration:.001ms !important;
  }
  .reveal{opacity:1;transform:none}
  .hero-canvas{display:none}
  .scroll-progress{display:none}
  .iso-bg{transform:none}
}

@media print{
  .site-header,.hero-canvas,.scroll-hint,.marquee,.nav-toggle{display:none}
  body{background:#fff;color:#000}
  .hero,.section-dark,.section-cta,.strip,.site-footer{background:#fff;color:#000}
  .hero-title,.sec-head h2,.cap h3,.cc-v{color:#000}
  .grad{-webkit-text-fill-color:#0A1F3C;color:#0A1F3C}
}

/* ═══════════════ FICHAS DE MÓDULO (acordeón nativo) ═══════════════
   <details> nativo, no un acordeón en JavaScript: funciona sin JS, el
   navegador gestiona foco, teclado y anuncio en lectores de pantalla, y
   Google indexa el contenido de dentro. Full width porque una ficha en una
   columna de 282 px cae a 39 caracteres por línea. */

.mod-hint{
  font-size:.92rem;color:var(--ink-2);
  margin-bottom:18px;
}

.modulos{display:flex;flex-direction:column;gap:12px}

.mod{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:var(--r);
  box-shadow:var(--shadow-sm);
  transition:border-color .35s, box-shadow .4s var(--ease);
}
.mod:hover{border-color:rgba(34,211,238,.45)}
.mod[open]{
  border-color:rgba(34,211,238,.5);
  box-shadow:var(--shadow);
}

/* Remove the default triangle in every engine. */
.mod-head::-webkit-details-marker{display:none}
.mod-head{list-style:none}
.mod-head::marker{content:''}

.mod-head{
  display:grid;
  grid-template-columns:auto 1fr auto auto;
  align-items:center;
  gap:clamp(12px,2vw,22px);
  padding:clamp(18px,2.2vw,24px) clamp(20px,2.4vw,28px);
  cursor:pointer;
  border-radius:var(--r);
}
.mod-head:focus-visible{
  outline:2.5px solid var(--cyan-400);
  outline-offset:2px;
}

.mod-num{
  font-family:var(--f-head);font-weight:700;font-size:.86rem;
  letter-spacing:.14em;color:var(--cyan-ink);
}
.mod-id{display:flex;flex-direction:column;gap:4px;min-width:0}
.mod-id h3{font-size:1.16rem;font-weight:600}
.mod-teaser{font-size:.9rem;color:var(--ink-2);line-height:1.45}

.mod-chevron{
  display:grid;place-items:center;
  width:34px;height:34px;flex:none;
  border-radius:50%;
  color:var(--cyan-ink);
  background:rgba(34,211,238,.10);
  border:1px solid rgba(34,211,238,.28);
  transition:transform .4s var(--ease), background-color .3s;
}
.mod-chevron svg{width:15px;height:15px}
.mod[open] .mod-chevron{transform:rotate(180deg);background:rgba(34,211,238,.2)}

.mod-body{
  padding:0 clamp(20px,2.4vw,28px) clamp(24px,2.8vw,32px);
  border-top:1px solid var(--line);
  margin-top:-1px;
  padding-top:clamp(22px,2.6vw,28px);
}
.mod-cols{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));
  gap:clamp(20px,3vw,40px);
  margin-bottom:clamp(22px,2.6vw,30px);
}
.mod-block h4{
  font-size:.82rem;font-weight:600;
  letter-spacing:.16em;text-transform:uppercase;
  color:var(--cyan-ink);
  margin-bottom:10px;
}
.mod-block p{color:var(--ink-2);font-size:.98rem;max-width:62ch}
.mod-block p strong{color:var(--ink);font-weight:600}

.deliver{display:grid;gap:9px;max-width:62ch}
.deliver li{
  position:relative;
  padding-left:26px;
  font-size:.96rem;color:var(--ink-2);
}
.deliver li::before{
  content:'';position:absolute;left:0;top:.5em;
  width:11px;height:6px;
  border-left:2px solid var(--cyan-ink);
  border-bottom:2px solid var(--cyan-ink);
  transform:rotate(-45deg);
}

.mod-cta{margin-top:clamp(20px,2.4vw,26px)}

/* Opening animation, only where motion is welcome. */
@media (prefers-reduced-motion:no-preference){
  .mod[open] .mod-body{animation:modOpen .42s var(--ease)}
  @keyframes modOpen{
    from{opacity:0;transform:translateY(-8px)}
    to{opacity:1;transform:none}
  }
}

@media (max-width:700px){
  .mod-head{
    grid-template-columns:auto 1fr auto;
    grid-template-areas:'num id chev' 'tags tags tags';
    row-gap:12px;
  }
  .mod-num{grid-area:num}
  .mod-id{grid-area:id}
  .mod-head .tags{grid-area:tags}
  .mod-chevron{grid-area:chev}
}


/* ═══════════════════════════════════════════════════════════
   TEMA CLARO — ETIC SAS
   Se activa con <html data-theme="claro">. Capa de anulación:
   no toca styles.css, de modo que el sitio navy sigue intacto.

   Qué cambia: las secciones que eran navy (36% de la página)
   pasan a una banda clara. Consecuencia que hay que compensar:
   hoy el ritmo visual lo cargan los bloques oscuros, y al
   quitarlos los tres tonos claros quedan a 1,07–1,24 de
   contraste entre sí, o sea indistinguibles. Por eso la banda
   es #CFDEEE (1,37 frente al blanco), la alternancia se fuerza
   sección a sección y cada banda lleva borde.

   Contrastes verificados sobre la banda #CFDEEE:
     --ink       #0A1F3C  12,04:1
     --ink-2     #3D5573   5,59:1
     --cyan-ink  #0B6478   4,93:1   (oscurecido: el de base daba 4,28)
     --ink-muted #4F6276   4,59:1   (oscurecido: el de base daba 4,07)
   ═══════════════════════════════════════════════════════════ */

:root[data-theme="claro"]{
  /* La banda que sustituye al navy, y su variante para degradados. */
  --band:#CFDEEE;
  --band-soft:#E3EDF7;
  --band-line:#B4C9DF;

  /* --on-dark y --on-dark-2 son semánticos: "primer plano sobre la
     banda". En este tema la banda es clara, así que pasan a tinta. */
  --on-dark:#0A1F3C;
  --on-dark-2:#3D5573;

  /* Oscurecidos para superar 4,5:1 sobre la banda. */
  --cyan-ink:#0B6478;
  --ink-muted:#4F6276;

  --line:#C7D6E6;

  /* Colores de la red de nodos del hero. main.js los lee de aquí:
     el cian claro original es invisible sobre fondo claro. */
  --net-link:16,48,92;
  --net-dot:11,100,120;
}

/* ─────────── Alternancia de secciones ───────────
   Se fuerza sección a sección. Sin esto quedarían sector, stack y
   nosotros seguidas en claro: 53% de la página sin separación. */
:root[data-theme="claro"] .section-mist{background:var(--paper)}
:root[data-theme="claro"] #stack{
  background:var(--band);
  border-block:1px solid var(--band-line);
}

:root[data-theme="claro"] .hero{
  background:
    radial-gradient(1100px 620px at 78% -8%, rgba(34,211,238,.20), transparent 62%),
    radial-gradient(760px 520px at 8% 108%, rgba(27,76,134,.10), transparent 66%),
    linear-gradient(168deg,var(--band-soft) 0%,var(--band) 100%);
  color:var(--ink);
  border-bottom:1px solid var(--band-line);
}
:root[data-theme="claro"] .hero-canvas{opacity:.5}
:root[data-theme="claro"] .hero-glow{
  background:radial-gradient(circle,rgba(34,211,238,.28),transparent 64%);
}
:root[data-theme="claro"] .hero-title{color:var(--ink)}
:root[data-theme="claro"] .hero-sub{color:var(--ink-2)}
:root[data-theme="claro"] .hero-sub strong{color:var(--ink)}

:root[data-theme="claro"] .strip{
  background:var(--band-soft);
  color:var(--ink);
  border-block:1px solid var(--band-line);
}
:root[data-theme="claro"] .strip-quote{color:var(--ink-2)}
