  if (toggle && nav) {
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });
    nav.addEventListener('click', function (e) {
      if (e.target.closest('a')) closeNav();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeNav();
    });
  }

  /* ── Scroll reveal ──────────────────────────────────────
     The animation must never be the only thing that makes
     content visible. If IntersectionObserver is missing, or
     never fires (the page was opened in a background tab, so
     the document is hidden and delivers no records), the
     failsafe below still shows everything in view. Otherwise
     a visitor switches to the tab and finds a blank page. */
  var revealables = document.querySelectorAll('.reveal');

  function revealAll() {
    revealables.forEach(function (el) { el.classList.add('in'); });
  }

  function revealInViewport() {
    revealables.forEach(function (el) {
      if (el.classList.contains('in')) return;
      var r = el.getBoundingClientRect();
      if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('in');
    });
  }

  if (!('IntersectionObserver' in window) || reduce) {
    revealAll();
  } else {
    var revealer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('in');
        revealer.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
    revealables.forEach(function (el) { revealer.observe(el); });

    /* Scroll is the safety net, not a second opinion: it keeps the
       reveal correct even if the observer never delivers a record.
       Throttled on a timestamp, NOT requestAnimationFrame — rAF is
       paused in hidden documents, which is precisely the case a
       failsafe has to survive. Idempotent; unbinds when all are in. */
    var lastSweep = 0;
    function sweep() {
      var now = Date.now();
      if (now - lastSweep < 100) return;
      lastSweep = now;
      revealInViewport();
      if (!document.querySelector('.reveal:not(.in)')) {
        window.removeEventListener('scroll', sweep);
        document.removeEventListener('visibilitychange', sweep);
      }
    }
    window.addEventListener('scroll', sweep, { passive: true });
    document.addEventListener('visibilitychange', sweep);
    setTimeout(function () { lastSweep = 0; sweep(); }, 1200);
  }

  /* ── Count-up stats ─────────────────────────────────────── */
  var counters = document.querySelectorAll('.stat-n[data-count]');
  function render(el, value) {
    var prefix = el.dataset.prefix || '';
    var suffix = el.dataset.suffix || '';
    el.textContent = prefix + value + suffix;
  }
  function runCount(el) {
    var target = parseInt(el.dataset.count, 10);
    if (!isFinite(target)) return;
    if (reduce) { render(el, target); return; }

    var duration = 1500;
    var start = null;
    function step(ts) {
      if (start === null) start = ts;
      var t = Math.min((ts - start) / duration, 1);
      var eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
      render(el, Math.round(target * eased));
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  function settleCounters() {
    counters.forEach(function (el) {
      if (el.dataset.done) return;
      el.dataset.done = '1';
      render(el, parseInt(el.dataset.count, 10));
    });
  }

  if (!('IntersectionObserver' in window)) {
    settleCounters();
  } else {
    var countObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting || entry.target.dataset.done) return;
        entry.target.dataset.done = '1';
        runCount(entry.target);
        countObserver.unobserve(entry.target);
      });
    }, { threshold: 0.5 });
    counters.forEach(function (el) { countObserver.observe(el); });

    // Same failsafe as the reveals: a stat must never sit at 0.
    setTimeout(settleCounters, 2600);
  }

  /* ── Pointer glow on solution cards ─────────────────────── */
  if (!reduce && window.matchMedia('(hover: hover)').matches) {
    document.querySelectorAll('.card').forEach(function (card) {
      card.addEventListener('pointermove', function (e) {
        var r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });
  }

  /* ── Hero circuit network ───────────────────────────────── */
  (function heroNetwork() {
    var canvas = document.getElementById('heroCanvas');
    if (!canvas || reduce) return;

    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var dpr = Math.min(window.devicePixelRatio || 1, 2);

    /* Read the network colours from CSS so a theme can change them. The
       pale cyan that works on navy is invisible on a light background. */
    var rootStyle = getComputedStyle(document.documentElement);
    var LINK_RGB = (rootStyle.getPropertyValue('--net-link') || '').trim() || '34,211,238';
    var DOT_RGB = (rootStyle.getPropertyValue('--net-dot') || '').trim() || '103,232,249';

    var nodes = [];
    var w = 0, h = 0;
    var LINK_DIST = 148;
    var running = true;
    var rafId = null;

    var retryTimer = null;

    function resize() {
      var rect = canvas.getBoundingClientRect();

      /* Zero width means the page has no layout yet (loaded in a background
         tab). Retry on a timer: ResizeObserver and rAF are both paused in a
         hidden document, so neither can be the recovery path here. */
      if (!rect.width || !rect.height) {
        if (!retryTimer) {
          retryTimer = setInterval(function () {
            var r = canvas.getBoundingClientRect();
            if (!r.width || !r.height) return;
            clearInterval(retryTimer);
            retryTimer = null;
            resize();
          }, 400);
        }
        return;
      }
      if (retryTimer) { clearInterval(retryTimer); retryTimer = null; }

      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Density scales with area, capped so phones stay smooth.
      var count = Math.max(18, Math.min(64, Math.round((w * h) / 22000)));
      nodes = [];
      for (var i = 0; i < count; i++) {
        nodes.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.24,
          vy: (Math.random() - 0.5) * 0.24,
          r: Math.random() * 1.5 + 0.8
        });
      }
    }

    function frame() {
      if (!running) return;
      ctx.clearRect(0, 0, w, h);

      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;

        for (var j = i + 1; j < nodes.length; j++) {
          var m = nodes[j];
          var dx = n.x - m.x, dy = n.y - m.y;
          var d = Math.hypot(dx, dy);
          if (d > LINK_DIST) continue;
          ctx.strokeStyle = 'rgba(' + LINK_RGB + ',' + (0.20 * (1 - d / LINK_DIST)).toFixed(3) + ')';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(n.x, n.y);
          ctx.lineTo(m.x, m.y);
          ctx.stroke();
        }

        ctx.fillStyle = 'rgba(' + DOT_RGB + ',.62)';
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }
      rafId = requestAnimationFrame(frame);
    }

    resize();
    frame();

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 180);
    });

    /* A canvas laid out at 0×0 (page loaded in a background tab)
       would stay blank forever, because resize() only runs on load.
       ResizeObserver re-seeds it the moment it gets real dimensions. */
    if ('ResizeObserver' in window) {
      new ResizeObserver(function () {
        var rect = canvas.getBoundingClientRect();
        if (rect.width && Math.abs(rect.width - w) > 1) resize();
      }).observe(canvas);
    }

    // Stop painting when the hero scrolls out of view or the tab hides.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !running) {
            running = true;
            frame();
          } else if (!entry.isIntersecting) {
            running = false;
            if (rafId) cancelAnimationFrame(rafId);
          }
        });
      }, { threshold: 0 }).observe(canvas);
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        running = false;
        if (rafId) cancelAnimationFrame(rafId);
      } else if (!running) {
        running = true;
        frame();
      }
    });
  })();

  /* ── Deep links into a module ficha ──────────────
     eticsas.co/#tarifador should land with that ficha already open, so a
     salesperson can send the exact link. Progressive enhancement only: the
     <details> elements work on their own without any of this. */
  function openFromHash() {
    var id = (window.location.hash || '').slice(1);
    if (!id) return;
    var el = document.getElementById(id);
    if (el && el.tagName === 'DETAILS') {
      el.open = true;
      el.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
    }
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  /* Keep the address bar in step when a ficha is opened by hand, so the
     visitor can copy the URL and it points at what they are reading. */
  document.querySelectorAll('details.mod[id]').forEach(function (d) {
    d.addEventListener('toggle', function () {
      if (!d.open || !window.history.replaceState) return;
      /* Opened straight from disk (file://) the origin is null and
         replaceState throws a SecurityError. The address bar is a nicety;
         never let it break the page during a live demo. */
      try {
        window.history.replaceState(null, '', '#' + d.id);
      } catch (e) { /* no-op */ }
    });
  });

  /* ── Contact form → mailto ──────────────────────────────
     GoDaddy static hosting has no mail backend, so the form
     composes a message in the visitor's own mail client. */
  var form = document.getElementById('contactForm');
  var hint = document.getElementById('formHint');
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      var data = new FormData(form);
      var nombre = (data.get('nombre') || '').toString().trim();
      var empresa = (data.get('empresa') || '').toString().trim();
      var correo = (data.get('correo') || '').toString().trim();
      var mensaje = (data.get('mensaje') || '').toString().trim();

      var subject = 'Consulta desde eticsas.co' + (empresa ? ' — ' + empresa : '');
      var body = [
        'Nombre: ' + nombre,
        'Empresa: ' + (empresa || '(no indicada)'),
        'Correo: ' + correo,
        '',
        mensaje
      ].join('\n');

      window.location.href = 'mailto:gerencia@eticsas.co'
        + '?subject=' + encodeURIComponent(subject)
        + '&body=' + encodeURIComponent(body);

      if (hint) {
        hint.textContent = 'Abrimos tu correo con el mensaje listo. Si no se abre, escríbenos a gerencia@eticsas.co';
      }
    });
  }
})();

</script>
</body>
</html>
